# Copy to .env for local development. Never put real values in this file.
# Production values must be configured as platform environment variables/secrets.

# Required database connection (use a TLS-enabled PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Required AI provider credentials
GROQ_API_KEY=replace-with-local-secret
GROQ_MODEL=openai/gpt-oss-120b

# Optional Google PageSpeed API key
GOOGLE_PAGESPEED_API_KEY=replace-with-local-secret

# Add new secret settings here as placeholders only. Do not commit .env.

# Optional outbound email for requested PDF delivery and license delivery.
# Configure these in the deployment secret manager, never in GitHub source.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Optional Stripe Payment Links. Configure both the checkout URL and its plink_ ID
# for a plan. Create a Stripe webhook for checkout.session.completed and
# checkout.session.async_payment_succeeded pointing to /api/v1/billing/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_URL_STARTER=
STRIPE_PAYMENT_LINK_ID_STARTER=
LICENSE_MONTHLY_AUDITS_STARTER=100
STRIPE_CHECKOUT_URL_PRO=
STRIPE_PAYMENT_LINK_ID_PRO=
LICENSE_MONTHLY_AUDITS_PRO=500
STRIPE_CHECKOUT_URL_BUSINESS=
STRIPE_PAYMENT_LINK_ID_BUSINESS=
LICENSE_MONTHLY_AUDITS_BUSINESS=2000
