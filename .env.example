# Copy to .env for local development. Never put real values in this file.
# Production values must be configured as platform environment variables/secrets.

# Required database connection (use a TLS-enabled PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Required AI provider credentials
GROQ_API_KEY=replace-with-local-secret
GROQ_MODEL=openai/gpt-oss-120b

# Optional Google PageSpeed API key
GOOGLE_PAGESPEED_API_KEY=replace-with-local-secret

# Add new secret settings here as placeholders only. Do not commit .env.

# Optional outbound email for requested PDF delivery and license delivery.
# Configure these in the deployment secret manager, never in GitHub source.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Paddle Billing. Use sandbox while testing; keep secrets in deployment settings, never in Git.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Optional approved Paddle checkout page URL; blank uses Paddle's default payment link.
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_ID_STARTER=
LICENSE_MONTHLY_AUDITS_STARTER=100
PADDLE_PRICE_ID_PRO=
LICENSE_MONTHLY_AUDITS_PRO=500
PADDLE_PRICE_ID_BUSINESS=
LICENSE_MONTHLY_AUDITS_BUSINESS=2000

# Configurable per-plan simultaneous audit limits. Change these environment values anytime.
# Monthly allowances above are also configurable; existing license records may need syncing
# when a plan's monthly allowance changes.
LICENSE_MAX_CONCURRENT_AUDITS_STARTER=1
LICENSE_MAX_CONCURRENT_AUDITS_PRO=3
LICENSE_MAX_CONCURRENT_AUDITS_BUSINESS=10
