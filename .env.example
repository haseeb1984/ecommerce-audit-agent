# Copy to .env for local development. Never put real values in this file.
# Production values must be configured as platform environment variables/secrets.

# Required database connection (use a TLS-enabled PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Required AI provider credentials
GROQ_API_KEY=replace-with-local-secret
GROQ_MODEL=openai/gpt-oss-120b

# Optional Google PageSpeed API key
GOOGLE_PAGESPEED_API_KEY=replace-with-local-secret

# Add new secret settings here as placeholders only. Do not commit .env.
