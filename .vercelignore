# Keep development-only files out of Vercel deployment uploads.
# Keep runtime modules, requirements.txt, vercel.json, and the Supabase CA certificate.
# SQL migrations remain tracked in Git for controlled database operations but are not needed in the runtime bundle.
.git/
.github/
docs/
tests/
scripts/
migrations/
__pycache__/
**/__pycache__/
.pytest_cache/
.venv/
venv/
*.py[cod]
*.log
requirements-dev.in
requirements-dev.txt
PRODUCTION_READINESS.md
backend_context_spec.md
